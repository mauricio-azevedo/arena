{
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:check": "pnpm -r run lint:check && pnpm run lint:docs",
    "lint:docs": "markdownlint-cli2 \"docs/decisions/*.md\" \"#docs/decisions/adr-template*.md\"",
    "knip": "pnpm -r run knip",
    "test": "pnpm --filter @arena/api test",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.8.3"
  }
}
