{
  "name": "@arena/contracts",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./matches": {
      "types": "./dist/matches.d.ts",
      "default": "./dist/matches.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "default": "./dist/profiles.js"
    },
    "./members": {
      "types": "./dist/members.d.ts",
      "default": "./dist/members.js"
    },
    "./ranking": {
      "types": "./dist/ranking.d.ts",
      "default": "./dist/ranking.js"
    },
    "./groups": {
      "types": "./dist/groups.d.ts",
      "default": "./dist/groups.js"
    },
    "./invites": {
      "types": "./dist/invites.d.ts",
      "default": "./dist/invites.js"
    },
    "./claims": {
      "types": "./dist/claims.d.ts",
      "default": "./dist/claims.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./me": {
      "types": "./dist/me.d.ts",
      "default": "./dist/me.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "default": "./dist/notifications.js"
    },
    "./weekly-highlights": {
      "types": "./dist/weekly-highlights.d.ts",
      "default": "./dist/weekly-highlights.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
