{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "declaration": true,
    "strict": true,
    "types": ["node", "jest"],
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // All of src, specs included: ts-jest type-checks them against this config.
  // tsconfig.build.json drops them from the emitted output.
  "include": ["src"]
}
